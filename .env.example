# ==========================
# .env.example — Sao chép thành .dev.vars để chạy local
# KHÔNG điền giá trị thật vào file này!
# ==========================

JWT_SECRET="your-secret-key-min-32-chars"
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RESEND_API_KEY="re_..."
CLOUDFLARE_ACCESS_AUD="your-cf-access-audience-tag"
ENVIRONMENT="development"

# Cloudflare Turnstile
# PUBLIC site key → storefront-ui/.env.production (NEXT_PUBLIC_TURNSTILE_SITE_KEY)
# SECRET key     → wrangler secret put TURNSTILE_SECRET_KEY (public-api worker only, never commit)
TURNSTILE_SECRET_KEY="0x4AAAAA..."
