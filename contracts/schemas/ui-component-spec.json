{
  "components": [
    {
      "name": "ProductList",
      "props": {
        "products": "ProductData[]",
        "onCreateNew": "() => void",
        "onEdit": "(product: ProductData) => void"
      },
      "state": [],
      "description": "Renders the glass-table of products."
    },
    {
      "name": "ProductForm",
      "props": {
        "productId": "string | null",
        "API_BASE_URL": "string",
        "onSaveSuccess": "() => void",
